# =============================================================================
#  TickerForge — configuration
# =============================================================================
#
#   cp .env.example .env      then fill in the REQUIRED block below.
#
#  Everything else has a working default; the values shown are those defaults,
#  so an entry you never touch behaves exactly as if it weren't here.
#
#  WHERE A SETTING LIVES
#  Some of these can also be changed in the browser (Settings page) without
#  restarting anything. Those are marked [browser]. The rest are read at
#  startup, so changing them means restarting the services.
#
#  Anything that decides how to REACH an external service — API keys, the ntfy
#  topic, the command PIN — is deliberately not editable from the browser. A
#  page with no authentication is not where credentials belong, and a form that
#  can retarget the notification channel is a form that can silently redirect
#  your alerts.
#
#  This file is a template. Keep the real .env out of version control: it holds
#  your broker secret.
# =============================================================================


# -----------------------------------------------------------------------------
#  REQUIRED — nothing works without these three
# -----------------------------------------------------------------------------

# From https://developers.kite.trade — create an app, then copy both values.
# The API key is also embedded in the login URL, so it isn't especially secret;
# the secret is, and it's what signs your session exchange.
KITE_API_KEY=
KITE_API_SECRET=

# Your private ntfy.sh topic. This is the channel every push arrives on:
# alerts, the pre-market brief, paper fills, the daily-loss stand-down.
#
# On ntfy.sh the topic name IS the password — anyone who knows it can read
# your notifications and, if NTFY_CMD_TOPIC is set, send commands to your
# machine. Use something long and unguessable, not "tickerforge".
NTFY_TOPIC=


# -----------------------------------------------------------------------------
#  NOTIFICATIONS
# -----------------------------------------------------------------------------

# Self-hosted ntfy? Point this at it. Otherwise leave as-is.
NTFY_SERVER=https://ntfy.sh

# Access token, if your server supports auth (self-hosted, or ntfy.sh with a
# reserved topic). This is what actually protects the channel — a topic name is
# only a secret until someone reads it over your shoulder.
NTFY_TOKEN=

# Two-way phone control. Set this to a SECOND topic (not NTFY_TOPIC) and run
# the `remote` service, and messages sent to it are executed as commands:
# /price, /alert, /paper fill, /compare, and the rest. See COMMANDS.md.
#
# Leave blank to keep notifications one-way. If you set it, set the PIN below.
NTFY_CMD_TOPIC=

# PIN required by commands that CHANGE something (/alert, /log, /close,
# /paper fill, /approve). Read-only commands never ask for it.
#
# Weak by design — it travels in the message body — but it means a stranger who
# learns your command topic can still only read, not arm alerts or place
# semi-auto orders. Blank disables the check entirely.
NTFY_CMD_PIN=

# Which corporate events are allowed to interrupt you.  [browser]
# Available: RESULTS, CORP ACTION, DIVIDEND, CONCALL. `all` for everything.
#
# The default deliberately excludes CONCALL. Holding a stock should not
# subscribe you to its entire paperwork trail — ESOP allotments, trading-window
# notices, newspaper publications. Those are filtered out regardless.
EVENT_PUSH_CATEGORIES=RESULTS,CORP ACTION,DIVIDEND

# How far ahead a dated event may be and still buzz. 0 = today only.  [browser]
#
# A board meeting three weeks out is a calendar entry, not a notification. It
# isn't lost: the morning brief lists everything due today or tomorrow. Set to
# 1 if you want tomorrow's on the buzzer too.
#
# Dividends gate on their EX/RECORD date, not the filing date — a dividend
# filed on 31 July for a 18 August record date buzzes on the 18th (or the 17th
# at horizon 1), which under T+1 is your last day to buy and qualify.
EVENT_PUSH_HORIZON_DAYS=0


# -----------------------------------------------------------------------------
#  RISK MODEL — how every position is sized
# -----------------------------------------------------------------------------

# Trading capital, in rupees. This is the number position sizing divides.
#
# Keep it honest. Sizing off a figure larger than you'd actually deploy makes
# every position too big, and you won't notice until the first bad run.
# 0 means sizing can't run — /size and paper entries will say so rather than
# guess.
ACCOUNT_SIZE=0                                                     # [browser]

# Percent of capital risked per trade — the distance from entry to stop, not
# the position value.
#
# 1% is the conventional starting point: it takes a long, bad run to do real
# damage, and any single trade is genuinely survivable.
RISK_PCT=1                                                         # [browser]

# Realised losses, in R, after which the guard tells you to stand down for the
# day. With RISK_PCT=1, 2R is 2% of capital.
#
# This also blocks new PAPER entries when the autopilot is running. Exits are
# never blocked — a limit that stops you closing a losing position is not risk
# control, it's a trap.
DAILY_LOSS_R=2                                                     # [browser]

# Most positions open at once, across everything.
MAX_POSITIONS=5                                                    # [browser]

# Hard ceiling on one position as a % of capital.
# 100 = cash account, no margin. Raise it only if you actually trade leveraged.
MAX_POSITION_PCT=100                                               # [browser]

# Round-trip costs in basis points, charged on BOTH legs.  [browser]
# Brokerage + STT + exchange + stamp + GST. 10 bps is a reasonable Indian
# delivery estimate; check your own contract notes.
#
# Used by the backtester, the paper broker and the journal alike — so R is net
# everywhere, and live can't look better than backtested for the sole reason
# that one of them ignored costs.
COST_BPS=10


# -----------------------------------------------------------------------------
#  PAPER TRADING — the account that trades itself
# -----------------------------------------------------------------------------
#  Play money, real mechanics. Its whole purpose is to be evidence about
#  whether to run this live, which is why the guardrails below apply even
#  though nothing is at stake: evidence gathered without limits says nothing
#  about a system that will have them.

# Master switch. 1 = queue tomorrow's orders from today's close at 15:40, and
# fill them at the open at 09:20, unattended.  [browser]
#
# Off by default. A paper account that starts trading because you updated the
# code is a surprise, even with play money.
PAPER_AUTO=0

# Which rules it follows.  [browser]
#   signals              follow whatever the EOD signal scan is set to
#   rsi_revert,sma_cross explicit list (see `tf backtest --list` for all 17)
#
# `signals` is the better default: the paper broker reads the same scan the EOD
# push reads, so the trades it takes and the alerts you receive can never
# disagree about what fired. Naming your own list breaks that on purpose —
# reasonable if you want paper testing mean-reversion while alerts stay on
# trend rules — and /paper says so rather than leaving you to notice.
PAPER_STRATEGIES=signals

# Initial stop below entry, as a percent.  [browser]
# It sizes the position AND it is enforced: a position trading through it is
# closed at the stop, or at the open if the day gapped past it.
PAPER_STOP_PCT=5

# Most paper positions open at once.  [browser]
PAPER_MAX_POSITIONS=8

# Trail the stop at highest-high-since-entry minus N x ATR. 0 = off. [browser]
#
# With this off, a winner gives back every rupee of open profit waiting for the
# strategy to flip — so trend systems look far worse on paper than they are,
# one-directionally, which is how you'd conclude an edge wasn't there when it
# was. Set it to whatever multiple your backtests use.
#
# The trail is a ratchet and never goes below the initial stop. The stop stored
# on the trade is NOT rewritten as it moves: R is measured from the stop the
# position was sized against, and rescaling it mid-trade would make expectancy
# depend on how long you held.
PAPER_TRAIL_MULT=0

# Bars in the ATR the trail is measured from.  [browser]
# 22 matches the backtester's default. Changing one without the other makes
# `tf journal compare` compare two different systems.
PAPER_TRAIL_PERIOD=22

# 1 = skip new entries while the index is below its own 200-day.  [browser]
#
# Long signals in a risk-off tape are where breakout systems bleed. Exits are
# never gated. A benchmark that can't be read counts as UNKNOWN, not bearish —
# a missing index must not silently stop the account trading for a week.
PAPER_REGIME_GATE=0


# -----------------------------------------------------------------------------
#  LIVE TRADING — real money. Read this section twice.
# -----------------------------------------------------------------------------
#  Both switches are required, and they are separate on purpose. One of them
#  being set by accident does nothing.

# 1 = the semi-auto flow may place REAL orders on approval.
LIVE_TRADING=0

# 1 = signal flips generate an order proposal with an Approve button on your
# phone. Nothing is placed until you tap it, and each token is single-use and
# expires.
SEMIAUTO=0

# Public HTTPS base URL for this machine, if you have one (Tailscale Funnel,
# Cloudflare Tunnel, a reverse proxy). Used for the Kite login redirect and for
# the approve/reject links in phone pushes.
#
# Leave blank if you only ever use the browser on the same machine.
PUBLIC_BASE_URL=


# -----------------------------------------------------------------------------
#  DATA & NEWS
# -----------------------------------------------------------------------------

# 1 = fetch fundamentals automatically when a symbol joins the watchlist.
# Turning this off means `roe`, `pe`, `fin("sales")` and the rest read blank
# for new names until you run `tf fundamentals fetch` yourself.
AUTO_FETCH_ON_ADD=1

# 1 = push a notification when a background fundamentals fetch finishes.
# Off by default: it's housekeeping, not news.
AUTO_FETCH_NOTIFY=0

# 1 = include Moneycontrol in the news feed alongside the others.
NEWS_MONEYCONTROL=1

# Who summarises the news digest: none | ollama | claude       [browser]
#   none    headlines only, no summarisation, no API calls
#   ollama  a local model — private, free, needs Ollama running
#   claude  the Anthropic API — better summaries, costs money per digest
NEWS_CURATOR=none

# Only used when NEWS_CURATOR=ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Only used when NEWS_CURATOR=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Screener.in screen ID backing the "latest results" page. The default is a
# public screen; swap it for your own screen's ID if you'd rather use that.
LATEST_RESULTS_SCREEN=608536


# -----------------------------------------------------------------------------
#  HOUSEKEEPING
# -----------------------------------------------------------------------------

# Nights of database backups to keep before pruning.  [browser]
# Backups are taken through SQLite's online backup API, so a snapshot is
# consistent even if something writes mid-copy.
BACKUP_KEEP_DAYS=14


# =============================================================================
#  NOT SET HERE
# =============================================================================
#  A few things live in the database rather than in this file, because they're
#  edited far more often than a config file should be:
#
#    * which strategies the EOD scan runs   — Settings page, or `tf signals set`
#    * your watchlist                       — `tf watch add SYM`
#    * saved queries and armed alerts       — the /query and /desk pages
#    * drawings and chart layouts           — the chart itself
#
#  And two paths are fixed, under data/ next to this file:
#  the database (tickerforge.db) and the cached Kite session token.
# =============================================================================
